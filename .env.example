# Used by `pnpm dev` (Node/Nitro) for local development.
# For `pnpm dev:worker` / `wrangler dev`, put the same values in .dev.vars.
NOTION_API_KEY=ntn_xxxxxxxxxxxx
# 推荐使用 data source ID
NOTION_DOCS_DATA_SOURCE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_BLOG_DATA_SOURCE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 也可以使用 database ID；代码会解析对应的 data source
# NOTION_DOCS_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NOTION_BLOG_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional property overrides and cache revalidation token.
# NOTION_DEFAULT_LOCALE=zh
# NIP_REVALIDATE_TOKEN=
