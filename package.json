    "deploy:worker": "pnpm build && wrangler deploy",
    "deploy": "pnpm run deploy:worker",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@notionhq/client": "^5.31.1",
    "@nuxt/ui": "^4.12.0",
    "@nuxtjs/i18n": "^10.6.0",
    "marked": "^18.1.3",
    "notion-to-md": "^3.1.9",
    "nuxt": "^4.6.3",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.150",
    "wrangler": "^4.158.0"
  }
}
