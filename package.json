{
  "name": "nip-website",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "dev:worker": "wrangler dev",
    "setup:notion": "node scripts/setup-notion.mjs",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
